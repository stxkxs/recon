# Recon Configuration
# Copy to ~/.config/recon/recon.yaml or ./recon.yaml
#
# This file lists every key recon actually reads. Per-module tuning today is
# limited to: enable/disable, per-operation timeouts, and a handful of
# wordlist/limit knobs (below). Detection lists (DNS record types, DKIM
# selectors, port set, tech fingerprints, CORS test origins, security-header
# set, etc.) are compiled into the modules and are not configurable here.
# Requires `yq` to be installed; without it, defaults + env vars are used.

global:
  # Directory for storing results
  output_dir: "~/.local/share/recon/results"

  # Output format: terminal, json, or both
  output_format: "terminal"

  # Color output: auto, always, never
  color: "auto"

# Timeout settings (in seconds) — one per module/operation.
# Override individually via RECON_TIMEOUT_<NAME> (e.g. RECON_TIMEOUT_DNS).
timeouts:
  dns: 5
  http: 10
  ssl: 5
  whois: 15
  ports: 2
  crt: 15
  waf: 10
  dnssec: 10
  takeover: 15
  shodan: 10
  virustotal: 10
  wayback: 30
  securitytrails: 15
  reverseip: 10
  asn: 15
  axfr: 10
  methods: 10
  dirs: 10
  jsanalysis: 15
  favicon: 10
  emailsec: 15

# Batch processing settings
batch:
  # Maximum parallel processes (1-32). Also settable via RECON_PARALLEL.
  max_parallel: 4

# Rate limiting
rate_limits:
  # Delay between WHOIS queries (seconds)
  whois_delay: 1

# Module configuration.
# Every module supports `enabled: true|false`. A few carry extra knobs.
modules:
  dns:
    enabled: true
  subdomain:
    enabled: true
    # Custom wordlist (empty = use built-in etc/subdomains.txt)
    wordlist: ""
  ssl:
    enabled: true
  http:
    enabled: true
  whois:
    enabled: true
  files:
    enabled: true
  tech:
    enabled: true
  ip:
    enabled: true
  ports:
    enabled: true
  cors:
    enabled: true
  score:
    enabled: true
  crt:
    enabled: true
  shodan:
    enabled: true
  virustotal:
    enabled: true
  waf:
    enabled: true
  dnssec:
    enabled: true
  takeover:
    enabled: true
  wayback:
    enabled: true
  securitytrails:
    enabled: true
  reverseip:
    enabled: true
  asn:
    enabled: true
  axfr:
    enabled: true
  methods:
    enabled: true
  dirs:
    enabled: true
    # Custom wordlist (empty = use built-in)
    wordlist: ""
    # Delay between directory requests (seconds)
    request_delay: 0.2
  jsanalysis:
    enabled: true
    # Cap on JS files fetched and per-file byte size
    max_files: 20
    max_file_size: 2097152
  favicon:
    enabled: true
  emailsec:
    enabled: true

# API keys for enhanced features
# Can also be set via environment variables:
#   RECON_API_SHODAN, RECON_API_SECURITYTRAILS, RECON_API_VIRUSTOTAL
api_keys:
  shodan: ""
  securitytrails: ""
  virustotal: ""
